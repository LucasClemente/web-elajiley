---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroMesa from '../components/HeroMesa.astro';
import Cinta from '../components/Cinta.astro';
import ManoScroll from '../components/ManoScroll.astro';
import Cifras from '../components/Cifras.astro';
import Naipe from '../components/Naipe.astro';
import TarjetaPagina from '../components/TarjetaPagina.astro';
import TarjetaBetzue from '../components/TarjetaBetzue.astro';
import BandaPractica from '../components/BandaPractica.astro';
import Faq from '../components/Faq.astro';
import hero from '../assets/hero.jpg';
import guaca from '../assets/marca/guaca.png';
import { PAGINAS } from '../lib/paginas';
import { SITE, BETZUE } from '../config';

const aprende = ['/reglas/', '/como-jugar/', '/valor-de-las-cartas/', '/estrategia/', '/vocabulario/', '/historia/', '/probabilidades/', '/variantes/']
  .map((h) => PAGINAS.find((p) => p.href === h))
  .filter((p) => p !== undefined);

const preguntas = [
  {
    q: '¿Qué es el ajiley?',
    a: 'El ajiley es un juego de cartas venezolano de envite y azar que se juega con la baraja española de 40 cartas. Cada jugador recibe cinco cartas, bota las que no le sirven y recibe otras, y gana quien sume más puntos con cartas de un mismo palo. La jugada máxima, de 51 puntos, se llama ajiley.',
  },
  {
    q: '¿Cuánto vale cada carta en el ajiley?',
    a: 'El as vale 11 puntos, el siete vale 7 y el seis vale 6. Todas las demás (el 2, el 3, el 4, el 5, la sota, el caballo y el rey) valen 10. Solo se suman las cartas del mismo palo. <a href="/valor-de-las-cartas/">Ver la tabla completa</a>.',
  },
  {
    q: '¿Qué es un ajiley en el juego?',
    a: 'Es la jugada máxima: el as y cuatro cartas de 10 puntos, todas del mismo palo, que suman 51. Sale en una de cada 4.700 manos repartidas, más o menos.',
  },
  {
    q: '¿Cuántas personas pueden jugar al ajiley?',
    a: 'Se juega entre 2 y 5 personas. Con cinco jugadores, en muchas mesas el siete de oros pasa a ser comodín.',
  },
  {
    q: '¿Se escribe ajiley, ajilei o ajilé?',
    a: 'La forma principal es «ajiley». El <em>Diccionario de americanismos</em> de las Academias de la Lengua recoge también «ajilé» y «ajiléi», y en internet se ve mucho «ajilei» y «jiley». <a href="/como-se-escribe/">Te lo explicamos aquí</a>.',
  },
  {
    q: '¿Dónde puedo jugar ajiley online?',
    a: `Puedes practicar gratis en nuestro <a href="/practicar/">simulador</a>. Si quieres jugar en una mesa real desde el celular, en Venezuela puedes hacerlo en <a href="${BETZUE.ajiley('inicio-faq')}">Betzue</a> (solo mayores de 18 años).`,
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#inicio`,
    url: `${SITE.url}/`,
    name: 'El Ajiley: cómo se juega el juego de cartas venezolano',
    inLanguage: SITE.lang,
    about: { '@id': `${SITE.url}/#juego` },
    isPartOf: { '@id': `${SITE.url}/#sitio` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: preguntas.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---
<Base
  title="El Ajiley: cómo se juega el juego de cartas venezolano"
  description="Todo sobre el ajiley, el juego de cartas venezolano con baraja española: reglas, puntuación, estrategia, vocabulario e historia. Practica gratis contra Guaca."
  schema={schema}
>
  <HeroMesa />
  <Cinta />

  <!-- QUÉ ES -->
  <section class="seccion queEs" aria-labelledby="que-es">
    <div class="contenedor queEs__fila">
      <div class="prosa">
        <span class="antetitulo">El juego</span>
        <h2 id="que-es">¿Qué es el <em>ajiley</em>?</h2>
        <p class="queEs__entrada">
          <strong>Un juego de cartas venezolano de envite y azar</strong> que se juega con la baraja española de 40 cartas. Cada jugador recibe
          cinco cartas, bota las que no le sirven y recibe otras, y gana quien sume más puntos con cartas de un mismo palo.
        </p>
        <p>
          Se juega entre dos y cinco personas, se envita en varias rondas (paso, voy, no voy, subo) y se presta para lo mejor de las mesas
          venezolanas: conversación, algo de faroleo y una buena dosis de suerte. El <em>Diccionario de americanismos</em>{' '}
          lo recoge como venezolanismo, también escrito <em>ajilé</em> o <em>ajiléi</em>.
        </p>
        <a href="/reglas/" class="enlace-flecha">Leer el reglamento completo</a>
      </div>

      <aside class="ficha" aria-label="Ficha del juego" data-tilt="8" data-revelar>
        <p class="ficha__titulo">Ficha del juego</p>
        <dl>
          <div><dt>Tipo</dt><dd>Envite y azar</dd></div>
          <div><dt>Jugadores</dt><dd>De 2 a 5</dd></div>
          <div><dt>Baraja</dt><dd>Española, 40 cartas</dd></div>
          <div><dt>Cartas</dt><dd>5 por jugador</dd></div>
          <div><dt>Descarte</dt><dd>Una sola vez</dd></div>
          <div><dt>Empate</dt><dd>Gana la mano</dd></div>
          <div><dt>Máximo</dt><dd class="oro-lamina">51 · ajiley</dd></div>
        </dl>
      </aside>
    </div>

    <div class="contenedor reglaOro">
      <span class="antetitulo">La regla de oro</span>
      <h2>El 2 vale más que el 7</h2>
      <p class="lead reglaOro__lead">Solo se suman las cartas del mismo palo. Y los valores tienen su truco:</p>
      <div class="reglaOro__cartas">
        <figure data-revelar><Naipe n={1} palo="copas" tam="l" /><figcaption><b>11</b> el as</figcaption></figure>
        <figure data-revelar><Naipe n={2} palo="copas" tam="l" /><figcaption><b>10</b> del 2 al 5</figcaption></figure>
        <figure data-revelar><Naipe n={12} palo="copas" tam="l" /><figcaption><b>10</b> las figuras</figcaption></figure>
        <figure data-revelar><Naipe n={7} palo="copas" tam="l" /><figcaption><b>7</b> el siete</figcaption></figure>
        <figure data-revelar><Naipe n={6} palo="copas" tam="l" /><figcaption><b>6</b> el seis</figcaption></figure>
      </div>
    </div>
  </section>

  <ManoScroll />

  <!-- APRENDE: NAIPES -->
  <section class="seccion aprende" aria-labelledby="aprende">
    <div class="contenedor">
      <div class="aprende__cabeza">
        <div>
          <span class="antetitulo">La guía completa</span>
          <h2 id="aprende">Todo el ajiley, <em>en ocho cartas</em></h2>
        </div>
        <p class="lead">Elige una. Cada carta es una sección de la guía, de las reglas a la historia.</p>
      </div>
      <div class="baraja">
        {aprende.map((p, i) => <TarjetaPagina pagina={p} i={i} />)}
      </div>
    </div>
  </section>

  <Cifras />

  <!-- HERRAMIENTAS -->
  <section class="seccion herramientas" aria-labelledby="herramientas">
    <div class="contenedor">
      <span class="antetitulo">Para practicar</span>
      <h2 id="herramientas">Juega sin <em>arriesgar nada</em></h2>
      <div class="herramientas__fila">
        <a class="herr herr--grande" href="/practicar/" data-tilt="6" data-revelar>
          <Image src={guaca} alt="" width={260} densities={[1, 2]} class="herr__guaca" loading="lazy" />
          <span class="herr__eti">Simulador</span>
          <strong>Juega contra Guaca</strong>
          <span>Manos completas con reglas venezolanas, rivales con personalidad y consejos en vivo. Gratis y sin registro.</span>
          <span class="enlace-flecha">Sentarse a la mesa</span>
        </a>
        <a class="herr" href="/calculadora/" data-tilt="8" data-revelar>
          <span class="herr__eti">Calculadora</span>
          <span class="herr__grande oro-lamina">41</span>
          <strong>¿Qué me conviene botar?</strong>
          <span>Tus puntos al instante y la mejor forma de botar entre las 32 posibles.</span>
          <span class="enlace-flecha">Calcular mi mano</span>
        </a>
        <a class="herr" href="/valor-de-las-cartas/#ponte-a-prueba-quién-gana" data-tilt="8" data-revelar>
          <span class="herr__eti">Juego</span>
          <span class="herr__grande oro-lamina">¿?</span>
          <strong>¿Quién gana?</strong>
          <span>Dos manos, una pregunta. Entrena el ojo hasta contar sin pensar.</span>
          <span class="enlace-flecha">Probar mi racha</span>
        </a>
      </div>
    </div>
  </section>

  <!-- LA MESA -->
  <section class="seccion mesa" aria-labelledby="mesa">
    <div class="contenedor mesa__fila">
      <div class="mesa__foto" data-revelar>
        <div class="mesa__marco" data-parallax="0.12">
          <Picture
            src={hero}
            formats={['avif', 'webp']}
            widths={[480, 760, 1100]}
            sizes="(max-width: 900px) 92vw, 600px"
            alt="Mesa de ajiley sobre tapete verde al atardecer: una mano con el as, el rey, el caballo, la sota y el siete de oros (48 puntos), fichas, café y tequeños"
            loading="lazy"
          />
        </div>
      </div>
      <div class="prosa">
        <span class="antetitulo">Tradición</span>
        <h2 id="mesa">De patio, de familia, <em>de pulpería</em></h2>
        <p>
          Como el dominó o el truco, el ajiley es de esos juegos que se aprenden mirando: alguien reparte, alguien explica a medias, y a la
          tercera mano ya estás botando cartas con criterio. Por eso las reglas cambian un poquito de una mesa a otra.
        </p>
        <p>
          Aquí tienes la forma más extendida de jugarlo, las <a href="/variantes/">variantes</a> que te puedes encontrar, el{' '}
          <a href="/vocabulario/">vocabulario</a> de la mesa y la <a href="/historia/">historia</a> de un juego que va de las pulperías de
          Niquitao al celular.
        </p>
      </div>
    </div>
  </section>

  <!-- BETZUE -->
  <section class="seccion betzueInicio" aria-label="Betzue">
    <div class="contenedor betzueInicio__fila">
      <div class="prosa">
        <span class="antetitulo">De la guía a la mesa</span>
        <h2>¿Listo para <em>jugar de verdad</em>?</h2>
        <p>
          Cuando quieras jugar contra personas y no contra Guaca, el ajiley venezolano también se juega en línea. En{' '}
          <a href={BETZUE.ajiley('inicio-texto')}>Betzue</a> tienes mesa de ajiley con las reglas de siempre, desde el celular y con recargas
          por Pago Móvil.
        </p>
        <p>
          Antes de jugar con dinero, repasa <a href="/jugar-online/">qué mirar en una plataforma</a> y nuestros consejos de{' '}
          <a href="/juego-responsable/">juego responsable</a>.
        </p>
      </div>
      <div data-revelar><TarjetaBetzue campana="inicio" /></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="seccion seccion--arena">
    <div class="contenedor faqInicio">
      <Faq preguntas={preguntas} />
      <a href="/preguntas-frecuentes/" class="enlace-flecha">Todas las preguntas</a>
    </div>
  </section>

  <BandaPractica />
</Base>

<style>
  /* Qué es */
  .queEs {
    padding-top: clamp(100px, 12vw, 160px);
  }
  .queEs__fila {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .queEs__entrada {
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.45rem);
    line-height: 1.5;
  }
  .ficha {
    padding: 28px 28px 18px;
    border-radius: 22px;
    background: linear-gradient(160deg, #fffefa, #f4ecdc);
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.08),
      0 40px 70px -30px rgb(20 14 6 / 0.55);
    rotate: 2deg;
  }
  .ficha__titulo {
    font-family: var(--f-titulo);
    font-weight: 650;
    font-size: 1.5rem;
    margin: 0 0 8px;
  }
  .ficha dl {
    margin: 0;
  }
  .ficha dl > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 0;
    border-top: 1px solid var(--linea);
  }
  .ficha dt {
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .ficha dd {
    margin: 0;
    font-weight: 800;
    text-align: right;
  }
  .ficha dd.oro-lamina {
    font-family: var(--f-titulo);
    font-size: 1.3rem;
    line-height: 1;
  }

  .reglaOro {
    margin-top: clamp(90px, 12vw, 150px);
    text-align: center;
  }
  .reglaOro .antetitulo {
    justify-content: center;
  }
  .reglaOro__lead {
    margin-inline: auto;
    max-width: 46ch;
  }
  .reglaOro__cartas {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(14px, 3vw, 36px);
    margin-top: 36px;
  }
  .reglaOro__cartas figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .reglaOro__cartas figure:nth-child(odd) :global(.naipe) {
    rotate: -4deg;
  }
  .reglaOro__cartas figure:nth-child(even) :global(.naipe) {
    rotate: 3deg;
  }
  .reglaOro__cartas figcaption {
    display: grid;
    font-weight: 800;
    color: var(--tinta-suave);
    font-size: 0.9rem;
  }
  .reglaOro__cartas b {
    font-family: var(--f-titulo);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--tinta);
  }
  .reglaOro__cartas figure:first-child b {
    color: var(--rojo);
  }

  /* Aprende */
  .aprende__cabeza {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .aprende__cabeza .lead {
    max-width: 38ch;
    margin: 0;
  }
  .aprende__cabeza h2 {
    margin: 0;
  }

  /* Herramientas */
  .herramientas__fila {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 20px;
    margin-top: 32px;
  }
  .herr {
    position: relative;
    display: grid;
    align-content: end;
    gap: 8px;
    min-height: 360px;
    padding: 64px 28px 28px;
    border-radius: 24px;
    color: #e8efe9;
    text-decoration: none;
    overflow: hidden;
    background:
      var(--fieltro),
      radial-gradient(ellipse at 30% 0%, rgb(46 160 105 / 0.4), transparent 60%), var(--tapete-900);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
    transition: box-shadow 0.4s var(--ease);
  }
  .herr:hover {
    box-shadow:
      0 40px 70px -30px rgb(0 0 0 / 0.8),
      0 0 0 2px rgb(242 193 78 / 0.55);
  }
  .herr strong {
    font-family: var(--f-titulo);
    font-weight: 650;
    font-size: 1.6rem;
    line-height: 1.1;
    color: #fff8ea;
  }
  .herr > span:not(.herr__eti, .herr__grande, .enlace-flecha) {
    color: #c9d8cf;
  }
  .herr .enlace-flecha {
    color: var(--oro);
    margin-top: 6px;
  }
  .herr__eti {
    position: absolute;
    top: 22px;
    left: 26px;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--oro);
  }
  .herr__grande {
    position: absolute;
    top: 30px;
    right: 26px;
    font-family: var(--f-titulo);
    font-weight: 800;
    font-size: 7rem;
    line-height: 1;
  }
  .herr--grande > :not(.herr__guaca, .herr__eti) {
    max-width: 58%;
  }
  .herr__guaca {
    position: absolute;
    right: -12px;
    bottom: -6px;
    width: min(200px, 42%);
    height: auto;
    filter: drop-shadow(0 20px 20px rgb(0 0 0 / 0.5));
    transition: transform 0.6s var(--ease);
  }
  .herr--grande:hover .herr__guaca {
    transform: rotate(-6deg) translateY(-6px);
  }

  /* Mesa */
  .mesa__fila {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .mesa__foto {
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--sombra-objeto);
    aspect-ratio: 4 / 3.3;
  }
  .mesa__marco {
    height: 118%;
    margin-top: -6%;
  }
  .mesa__marco :global(img),
  .mesa__marco :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% 50%;
  }

  /* Betzue */
  .betzueInicio__fila {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .faqInicio {
    max-width: 840px;
  }

  @media (max-width: 960px) {
    .herramientas__fila {
      grid-template-columns: 1fr;
    }
    .herr {
      min-height: 300px;
    }
    .herr__grande {
      font-size: 4.4rem;
      top: 22px;
    }
    .herr:not(.herr--grande) > strong {
      max-width: 72%;
    }
  }
  @media (max-width: 900px) {
    .queEs__fila,
    .mesa__fila,
    .betzueInicio__fila {
      grid-template-columns: 1fr;
    }
    .ficha {
      max-width: 420px;
    }
  }
</style>
