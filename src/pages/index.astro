---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mano from '../components/Mano.astro';
import TarjetaPagina from '../components/TarjetaPagina.astro';
import BandaPractica from '../components/BandaPractica.astro';
import Faq from '../components/Faq.astro';
import Repartidor from '../components/Repartidor.astro';
import hero from '../assets/hero.jpg';
import guaca from '../assets/marca/guaca.png';
import { PAGINAS } from '../lib/paginas';
import { SITE, BETZUE } from '../config';

const aprende = ['/reglas/', '/como-jugar/', '/valor-de-las-cartas/', '/estrategia/', '/vocabulario/', '/historia/']
  .map((h) => PAGINAS.find((p) => p.href === h))
  .filter((p) => p !== undefined);
const masTemas = ['/probabilidades/', '/variantes/', '/baraja-espanola/', '/como-se-escribe/', '/jugar-online/', '/preguntas-frecuentes/']
  .map((h) => PAGINAS.find((p) => p.href === h))
  .filter((p) => p !== undefined);

const preguntas = [
  {
    q: '¿Qué es el ajiley?',
    a: 'El ajiley es un juego de cartas venezolano de envite y azar que se juega con la baraja española de 40 cartas. Cada jugador recibe cinco cartas, bota las que no le sirven y recibe otras, y gana quien sume más puntos con cartas de un mismo palo. La jugada máxima, de 51 puntos, se llama ajiley.',
  },
  {
    q: '¿Cuánto vale cada carta en el ajiley?',
    a: 'El as vale 11 puntos, el siete vale 7 y el seis vale 6. Todas las demás (el 2, el 3, el 4, el 5, la sota, el caballo y el rey) valen 10. Solo se suman las cartas del mismo palo. <a href="/valor-de-las-cartas/">Ver la tabla completa</a>.',
  },
  {
    q: '¿Qué es un ajiley en el juego?',
    a: 'Es la jugada máxima: el as y cuatro cartas de 10 puntos, todas del mismo palo, que suman 51. Sale en una de cada 4.700 manos repartidas, más o menos.',
  },
  {
    q: '¿Cuántas personas pueden jugar al ajiley?',
    a: 'Se juega entre 2 y 5 personas. Con cinco jugadores, en muchas mesas el siete de oros pasa a ser comodín.',
  },
  {
    q: '¿Se escribe ajiley, ajilei o ajilé?',
    a: 'La forma principal es «ajiley». El <em>Diccionario de americanismos</em> de las Academias de la Lengua recoge también «ajilé» y «ajiléi», y en internet se ve mucho «ajilei» y «jiley». <a href="/como-se-escribe/">Te lo explicamos aquí</a>.',
  },
  {
    q: '¿Dónde puedo jugar ajiley online?',
    a: `Puedes practicar gratis en nuestro <a href="/practicar/">simulador</a>. Si quieres jugar en una mesa real desde el celular, en Venezuela puedes hacerlo en <a href="${BETZUE.ajiley('inicio-faq')}">Betzue</a> (solo mayores de 18 años).`,
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#inicio`,
    url: `${SITE.url}/`,
    name: 'Ajiley: qué es y cómo se juega el juego de cartas venezolano',
    inLanguage: SITE.lang,
    about: { '@id': `${SITE.url}/#juego` },
    isPartOf: { '@id': `${SITE.url}/#sitio` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: preguntas.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---
<Base
  title="Ajiley: qué es y cómo se juega el juego de cartas venezolano"
  description="Todo sobre el ajiley, el juego de cartas venezolano con baraja española: reglas, puntuación, estrategia, vocabulario e historia. Practica gratis contra Guaca."
  schema={schema}
>
  <section class="portada">
    <div class="contenedor portada__fila">
      <div class="portada__texto">
        <p class="antetitulo">La guía del juego de cartas venezolano</p>
        <h1>Ajiley: aprende a jugarlo de principio a fin</h1>
        <p class="lead">
          Reglas claras, la puntuación carta por carta, estrategia de verdad y la historia de un juego que se ha jugado en las mesas
          venezolanas por generaciones. Todo en un solo sitio, y gratis.
        </p>
        <div class="portada__botones">
          <a href="/reglas/" class="boton">Ver las reglas</a>
          <a href="/practicar/" class="boton boton--verde">Practicar gratis</a>
        </div>
      </div>
      <Repartidor />
    </div>
  </section>

  <section class="seccion" aria-labelledby="que-es">
    <div class="contenedor que-es">
      <div class="prosa">
        <h2 id="que-es">¿Qué es el ajiley?</h2>
        <p>
          <strong>El ajiley es un juego de cartas venezolano de envite y azar que se juega con la baraja española de 40 cartas.</strong>
          Cada jugador recibe cinco cartas, bota las que no le sirven y recibe otras, y gana la mano quien sume más puntos con cartas de un
          mismo palo. La jugada soñada es el <em>ajiley</em>: el as y cuatro cartas de 10 del mismo palo, 51 puntos.
        </p>
        <p>
          Tiene una rareza que desconcierta a los nuevos: el 2, el 3, el 4 y el 5 valen 10 puntos, como las figuras, mientras que el 7 y
          el 6 valen solo lo que marcan. Se juega entre dos y cinco personas, se envita en varias rondas (paso, voy, no voy, subo) y se
          presta para lo mejor de las mesas venezolanas: conversación, algo de faroleo y una buena dosis de suerte. El
          <em>Diccionario de americanismos</em> lo recoge como venezolanismo, también escrito <em>ajilé</em> o <em>ajiléi</em>.
        </p>
        <p><a href="/reglas/">Lee el reglamento completo</a> o sigue con el resumen.</p>
      </div>

      <aside class="ficha" aria-label="Ficha del juego">
        <h3>Ficha del juego</h3>
        <dl>
          <div><dt>Tipo</dt><dd>Envite y azar</dd></div>
          <div><dt>Jugadores</dt><dd>De 2 a 5</dd></div>
          <div><dt>Baraja</dt><dd>Española de 40 cartas</dd></div>
          <div><dt>Cartas por jugador</dt><dd>5</dd></div>
          <div><dt>Descarte</dt><dd>Una sola vez</dd></div>
          <div><dt>Valores</dt><dd>As 11 · 7 y 6 lo que marcan · resto 10</dd></div>
          <div><dt>Jugada máxima</dt><dd>Ajiley: 51 puntos</dd></div>
          <div><dt>Origen</dt><dd>Venezuela</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="seccion seccion--arena" aria-labelledby="resumen">
    <div class="contenedor">
      <h2 id="resumen">El ajiley en un minuto</h2>
      <ol class="minuto">
        <li>
          <strong>Se pone la entrada</strong>
          <span>Cada jugador aporta su parte al pote antes de repartir.</span>
        </li>
        <li>
          <strong>Dos cartas y a envitar</strong>
          <span>El pie reparte dos cartas a cada uno y empieza la primera ronda: pasar, ir, subir o irse.</span>
        </li>
        <li>
          <strong>Tres cartas más</strong>
          <span>Se completan las cinco cartas, una a una, y se vuelve a envitar.</span>
        </li>
        <li>
          <strong>Botar y pedir</strong>
          <span>Cada jugador bota las cartas que no le sirven y recibe otras. Solo una vez.</span>
        </li>
        <li>
          <strong>Se muestran las cartas</strong>
          <span>Tras el último envite, gana quien sume más puntos en un mismo palo.</span>
        </li>
      </ol>
      <Mano
        titulo="La mano soñada: un ajiley de oros (11 + 10 + 10 + 10 + 10)"
        cartas="1o 12o 11o 5o 2o"
        resultado="¡Ajiley! 51 puntos"
      />
      <p class="centrado"><a href="/como-jugar/" class="boton boton--claro">Ver una mano completa, paso a paso</a></p>
    </div>
  </section>

  <section class="seccion" aria-labelledby="aprende">
    <div class="contenedor">
      <h2 id="aprende">Aprende el juego</h2>
      <div class="rejilla">
        {aprende.map((p) => <TarjetaPagina pagina={p} />)}
      </div>
    </div>
  </section>

  <section class="seccion seccion--arena" aria-labelledby="mesa">
    <div class="contenedor mesa">
      <Picture
        src={hero}
        formats={['avif', 'webp']}
        widths={[480, 760, 1100, 1500]}
        sizes="(max-width: 900px) 100vw, 620px"
        alt="Mesa de ajiley sobre tapete verde al atardecer: una mano con el as, el rey, el caballo, la sota y el siete de oros (48 puntos), fichas, café y tequeños"
        loading="lazy"
      />
      <div class="prosa">
        <h2 id="mesa">Un juego de mesa, de patio y de familia</h2>
        <p>
          Como el dominó o el truco, el ajiley es de esos juegos que se aprenden mirando: alguien reparte, alguien explica a medias, y a la
          tercera mano ya estás botando cartas con criterio. Por eso las reglas cambian un poquito de una mesa a otra, y por eso conviene
          ponerse de acuerdo antes de repartir.
        </p>
        <p>
          En esta guía explicamos la forma más extendida de jugarlo, señalamos las <a href="/variantes/">variantes</a> que te puedes
          encontrar y te damos las palabras de la mesa, del <em>pie</em> a la <em>mano</em> pasando por el <em>¡barajo!</em>, en nuestro
          <a href="/vocabulario/"> vocabulario</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="seccion seccion--tapete" aria-labelledby="herramientas">
    <div class="contenedor herramientas">
      <div>
        <h2 id="herramientas">Practica sin arriesgar nada</h2>
        <p>
          Guaca reparte, tú decides. Juega manos completas con las reglas venezolanas en el simulador, o usa la calculadora para saber al
          instante cuántos puntos vale cualquier mano. Todo gratis, sin registro y sin dinero.
        </p>
        <div class="portada__botones">
          <a href="/practicar/" class="boton">Jugar contra Guaca</a>
          <a href="/calculadora/" class="boton boton--claro">Abrir la calculadora</a>
        </div>
      </div>
      <Image src={guaca} alt="Guaca, la guacamaya, enseñando un abanico de cartas de oros" width={300} densities={[1, 2]} loading="lazy" />
    </div>
  </section>

  <section class="seccion" aria-labelledby="mas">
    <div class="contenedor">
      <h2 id="mas">Más sobre el ajiley</h2>
      <div class="rejilla">
        {masTemas.map((p) => <TarjetaPagina pagina={p} />)}
      </div>
    </div>
  </section>

  <section class="seccion seccion--arena">
    <div class="contenedor prosa faq-inicio">
      <Faq preguntas={preguntas} />
    </div>
  </section>

  <BandaPractica />
</Base>

<style>
  .portada {
    padding-block: clamp(28px, 5vw, 64px);
    background:
      radial-gradient(circle at 85% 10%, rgb(255 194 14 / 0.25), transparent 40%),
      radial-gradient(circle at 0% 100%, rgb(11 107 69 / 0.14), transparent 45%);
  }
  .portada__fila {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .portada h1 {
    font-size: clamp(2.3rem, 1.5rem + 3.4vw, 4rem);
  }
  .portada__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 1.2em;
  }
  .mesa {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .mesa :global(img) {
    width: 100%;
    height: auto;
    border-radius: 24px;
    border: var(--borde-sticker);
    box-shadow: 0 8px 0 var(--noche);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 78% 50%;
    rotate: -1.5deg;
  }

  .que-es {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }
  .ficha {
    background: #fff;
    border: var(--borde-sticker);
    border-radius: var(--radio);
    box-shadow: 0 5px 0 var(--noche);
    padding: 22px 22px 14px;
  }
  .ficha h3 {
    margin-bottom: 0.6em;
  }
  .ficha dl {
    margin: 0;
  }
  .ficha dl > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px dashed var(--linea);
  }
  .ficha dt {
    color: var(--tinta-suave);
    font-weight: 700;
  }
  .ficha dd {
    margin: 0;
    font-weight: 800;
    text-align: right;
    color: var(--noche);
  }

  .minuto {
    list-style: none;
    counter-reset: m;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    padding: 0;
    margin: 0 0 8px;
  }
  .minuto li {
    counter-increment: m;
    background: #fff;
    border: 2px solid var(--linea);
    border-radius: var(--radio);
    padding: 16px;
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .minuto li::before {
    content: counter(m);
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--oro);
    border: 2px solid var(--noche);
    font-family: var(--f-titulo);
    font-weight: 800;
    color: var(--noche);
    margin-bottom: 6px;
  }
  .minuto strong {
    font-family: var(--f-titulo);
    color: var(--noche);
    font-size: 1.12rem;
    line-height: 1.2;
  }
  .minuto span {
    font-size: 0.95rem;
    color: var(--tinta-suave);
    line-height: 1.5;
  }
  .centrado {
    text-align: center;
  }

  .herramientas {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
  }
  .herramientas p {
    max-width: 58ch;
    font-size: 1.08rem;
  }
  .herramientas :global(img) {
    width: clamp(160px, 22vw, 280px);
  }
  .faq-inicio {
    margin-inline: auto;
  }

  @media (max-width: 1000px) {
    .minuto {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 900px) {
    .portada__fila,
    .mesa,
    .que-es {
      grid-template-columns: 1fr;
    }
    .herramientas {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .herramientas :global(img) {
      margin-inline: auto;
      order: -1;
    }
    .herramientas .portada__botones {
      justify-content: center;
    }
  }
  @media (max-width: 520px) {
    .minuto {
      grid-template-columns: 1fr;
    }
  }
</style>
