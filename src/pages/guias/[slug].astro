---
// Cada guía de src/content/guias se publica con la plantilla de artículo.
import { render } from 'astro:content';
import Articulo from '../../layouts/Articulo.astro';
import { pagina } from '../../lib/paginas';
import { guiasPublicadas, comoPagina, minutosDe, type Guia } from '../../lib/guias';

export async function getStaticPaths() {
  const guias = await guiasPublicadas();
  return guias.map((guia) => ({ params: { slug: guia.id }, props: { guia, todas: guias } }));
}

interface Props {
  guia: Guia;
  todas: Guia[];
}
const { guia, todas } = Astro.props;
const { Content, headings } = await render(guia);
const d = guia.data;

// "Sigue aprendiendo": las páginas que pide la guía y, para completar tres, otras guías
// (primero las de la misma categoría).
const fijas = d.relacionados.map(pagina).filter((p) => p !== undefined);
const otras = todas
  .filter((g) => g.id !== guia.id)
  .sort((a, b) => Number(b.data.categoria === d.categoria) - Number(a.data.categoria === d.categoria))
  .slice(0, Math.max(1, 3 - fijas.length))
  .map(comoPagina);

const frontmatter = {
  ...d,
  etiqueta: d.categoria,
  minutos: minutosDe(guia),
  padre: { name: 'Guías', href: '/guias/' },
};
---
<Articulo frontmatter={frontmatter} headings={headings} relacionados={[...fijas, ...otras].slice(0, 4)}>
  <Content />
</Articulo>
