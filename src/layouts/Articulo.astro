---
// Plantilla de los artículos MDX (frontmatter: layout: ../layouts/Articulo.astro).
import Base from './Base.astro';
import TarjetaPagina from '../components/TarjetaPagina.astro';
import BandaPractica from '../components/BandaPractica.astro';
import RotuloBetzue from '../components/RotuloBetzue.astro';
import { SITE, BETZUE, BETZUE_CTA } from '../config';
import { pagina, type Pagina } from '../lib/paginas';
import { COLOR_PALO, type Palo } from '../lib/naipe';
import type { Miga } from './Base.astro';

interface Faq {
  q: string;
  a: string;
}
interface Frontmatter {
  title: string;
  seoTitle?: string;
  description: string;
  miga: string;
  etiqueta?: string;
  lead?: string;
  publicado?: string;
  actualizado?: string;
  faq?: Faq[];
  relacionados?: string[];
  schemaExtra?: Record<string, unknown>[];
  minutos?: number;
  indice?: boolean;
  /** Página de herramienta: sin columna lateral y con el contenido a todo el ancho. */
  completo?: boolean;
  /** Sección a la que pertenece (p. ej. Guías), para las migas de pan. */
  padre?: Miga;
  palo?: Palo;
}
interface Props {
  frontmatter: Frontmatter;
  headings?: { depth: number; slug: string; text: string }[];
  /** Tarjetas de "Sigue aprendiendo" ya resueltas (las guías no están en PAGINAS). */
  relacionados?: Pagina[];
}

const { frontmatter: fm, headings = [] } = Astro.props;
const path = Astro.url.pathname;
const url = new URL(path, SITE.url).href;
const publicado = fm.publicado ?? SITE.updated;
const actualizado = fm.actualizado ?? publicado;
const h2 = headings.filter((h) => h.depth === 2);
const mostrarIndice = (fm.indice ?? true) && h2.length >= 3;
const relacionados = Astro.props.relacionados ?? (fm.relacionados ?? []).map(pagina).filter((p) => p !== undefined);
const palo: Palo = fm.palo ?? pagina(path)?.palo ?? 'oros';
const conBetzue = path in BETZUE_CTA || path.startsWith('/guias/');
const migas: Miga[] = [...(fm.padre ? [fm.padre] : []), { name: fm.miga, href: path }];

const fecha = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });

const schema: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    '@id': `${url}#articulo`,
    headline: fm.title,
    description: fm.description,
    inLanguage: SITE.lang,
    datePublished: publicado,
    dateModified: actualizado,
    mainEntityOfPage: url,
    ...(fm.etiqueta && { articleSection: fm.etiqueta }),
    image: new URL('/compartir.jpg', SITE.url).href,
    author: { '@id': `${SITE.url}/#organizacion` },
    publisher: { '@id': `${SITE.url}/#organizacion` },
    about: { '@id': `${SITE.url}/#juego` },
  },
  ...(fm.schemaExtra ?? []),
];
if (fm.faq?.length) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: fm.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<Base
  title={fm.seoTitle ?? fm.title}
  description={fm.description}
  type="article"
  schema={schema}
  migas={migas}
>
  <article class:list={['articulo', { 'articulo--completo': fm.completo }]} style={`--c:${COLOR_PALO[palo]}`}>
    <header class="articulo__cabecera oscuro">
      <svg class="articulo__palo-fondo" viewBox="0 0 40 40" aria-hidden="true" data-giro-scroll><use href={`#p-${palo}`} width="40" height="40"></use></svg>
      <div class="contenedor">
        <nav class="migas" aria-label="Migas de pan">
          <ol>
            <li><a href="/">Inicio</a></li>
            {fm.padre && <li><a href={fm.padre.href}>{fm.padre.name}</a></li>}
            <li aria-current="page">{fm.miga}</li>
          </ol>
        </nav>
        {fm.etiqueta && (
          <span class="etiqueta">
            <svg viewBox="0 0 40 40" aria-hidden="true"><use href={`#p-${palo}`} width="40" height="40"></use></svg>
            {fm.etiqueta}
          </span>
        )}
        <h1>{fm.title}</h1>
        {fm.lead && <p class="lead articulo__lead">{fm.lead}</p>}
        <p class="articulo__meta">
          Por la redacción de El Ajiley <span aria-hidden="true">·</span> Actualizado el{' '}
          <time datetime={actualizado}>{fecha(actualizado)}</time>
          {fm.minutos && (
            <>
              <span aria-hidden="true"> · </span>
              {fm.minutos} min de lectura
            </>
          )}
        </p>
      </div>
    </header>

    <div class="contenedor articulo__cuerpo">
      <div class="prosa">
        {mostrarIndice && (
          <details class="indice indice--movil">
            <summary>En esta página</summary>
            <ol>
              {h2.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )}
        <slot />

        {conBetzue && <RotuloBetzue ruta={path} />}

        {fm.faq?.length && (
          <section class="faq" aria-labelledby="preguntas">
            <h2 id="preguntas">Preguntas frecuentes</h2>
            {fm.faq.map((f) => (
              <details class="faq__item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}
      </div>

      <aside class="articulo__lateral" hidden={fm.completo}>
        {mostrarIndice && (
          <nav class="indice" aria-label="En esta página">
            <strong>En esta página</strong>
            <ol>
              {h2.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <div class="lateral__mesa sobre-tapete">
          <strong>¿Una mano?</strong>
          <p>Practica gratis contra Guaca, o juega de verdad en Betzue.</p>
          <a href="/practicar/" class="boton boton--oro boton--peque">Practicar gratis</a>
          <a href={BETZUE.ajiley(`lateral-${path.replace(/\//g, '')}`)} class="lateral__betzue">Jugar en Betzue →</a>
        </div>
      </aside>
    </div>

    {relacionados.length > 0 && (
      <section class="seccion seccion--tapete" aria-labelledby="sigue">
        <div class="contenedor">
          <span class="antetitulo">Sigue aprendiendo</span>
          <h2 id="sigue">Otra carta de la baraja</h2>
          <div class="baraja">
            {relacionados.map((p, i) => <TarjetaPagina pagina={p} i={i} />)}
          </div>
        </div>
      </section>
    )}
  </article>
  <BandaPractica />
</Base>

<style>
  .articulo__cabecera {
    position: relative;
    overflow: hidden;
    padding-block: clamp(44px, 7vw, 96px) clamp(40px, 6vw, 80px);
  }
  .articulo__palo-fondo {
    position: absolute;
    right: -40px;
    top: -30px;
    width: clamp(240px, 34vw, 460px);
    height: auto;
    opacity: 0.16;
    rotate: 14deg;
    pointer-events: none;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.5));
  }
  .articulo__cabecera .contenedor {
    position: relative;
  }
  .articulo__cabecera .etiqueta {
    margin-bottom: 0.8em;
  }
  .articulo__cabecera h1 {
    max-width: 17ch;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.8rem);
  }
  .articulo__lead {
    max-width: 58ch;
    margin-bottom: 1.2em;
  }
  .articulo__meta {
    color: rgb(232 239 233 / 0.6);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }
  .migas ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
    font-size: 0.86rem;
    color: rgb(232 239 233 / 0.6);
  }
  .migas a {
    color: rgb(232 239 233 / 0.75) !important;
  }
  .migas li + li::before {
    content: '/';
    margin-right: 6px;
    color: var(--oro);
  }
  .articulo__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: clamp(28px, 5vw, 72px);
    padding-block: clamp(32px, 5vw, 56px) clamp(56px, 8vw, 96px);
    align-items: start;
  }
  .articulo--completo .articulo__cuerpo {
    grid-template-columns: minmax(0, 1fr);
  }
  .articulo--completo .prosa {
    max-width: none;
  }
  .articulo--completo .prosa > :global(:where(p, ul, ol, h2, h3, blockquote, .nota, .faq, .resumen, .rotulo-betzue)) {
    max-width: var(--ancho-prosa);
  }
  .articulo__lateral {
    position: sticky;
    top: 104px;
    display: grid;
    gap: 22px;
  }

  /* Índice */
  .indice {
    padding: 20px 22px 16px;
    background: var(--superficie);
    border: 1px solid var(--superficie-borde);
    border-radius: var(--radio);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .indice ol {
    display: grid;
    gap: 6px;
  }
  .indice strong,
  .indice summary {
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rojo);
  }
  .indice ol {
    margin: 2px 0 0;
    padding-left: 1.1em;
  }
  .indice li::marker {
    font-family: var(--f-titulo);
    color: var(--tinta-suave);
  }
  .indice a {
    color: var(--tinta);
    text-decoration: none;
  }
  .indice a:hover {
    color: var(--rojo);
    text-decoration: underline;
  }
  .indice--movil {
    display: none;
    margin-bottom: 1.8em;
    transform: none;
  }
  .indice--movil summary {
    cursor: pointer;
  }

  .lateral__mesa {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding: 24px;
    border-radius: var(--radio);
    box-shadow: var(--sombra-objeto);
    overflow: hidden;
  }
  .lateral__mesa strong {
    font-family: var(--f-titulo);
    font-weight: 650;
    color: #fff8ea;
    font-size: 1.6rem;
    line-height: 1;
  }
  .lateral__mesa p {
    margin: 0;
    font-size: 0.95rem;
  }
  .lateral__betzue {
    font-weight: 900;
    font-size: 0.92rem;
  }

  /* Preguntas: fichas de cartulina */
  .faq {
    margin-top: 2.8em;
  }
  .faq__item {
    background: var(--superficie);
    border: 1px solid var(--superficie-borde);
    border-radius: 14px;
    margin-bottom: 10px;
    padding: 0 1.1em;
    border-left: 4px solid var(--c, var(--rojo));
  }
  .faq__item summary {
    cursor: pointer;
    padding: 0.95em 0;
    font-family: var(--f-titulo);
    font-weight: 650;
    font-size: 1.12rem;
    color: var(--tinta);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    font-size: 1.5rem;
    line-height: 1;
    color: var(--rojo);
    transition: transform 0.2s ease;
  }
  .faq__item[open] summary::after {
    transform: rotate(45deg);
  }
  .faq__item p {
    margin: 0 0 1em;
  }

  @media (max-width: 980px) {
    .articulo__cuerpo {
      grid-template-columns: minmax(0, 1fr);
    }
    .articulo__lateral {
      display: none;
    }
    .indice--movil {
      display: block;
    }
  }
</style>
