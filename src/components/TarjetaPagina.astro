---
// Una sección de la guía dibujada como naipe español: índice en las esquinas,
// pinta en el marco y el título donde iría la figura.
import type { Pagina } from '../lib/paginas';
import { svgMarco, COLOR_PALO, NUMEROS } from '../lib/naipe';

interface Props {
  pagina: Pagina;
  /** Posición en la mano (define el número de la carta). */
  i?: number;
}
const { pagina, i = 0 } = Astro.props;
const n = NUMEROS[i % NUMEROS.length];
const color = COLOR_PALO[pagina.palo];
---
<a href={pagina.href} class="carta-guia" style={`--c:${color}`}>
  <span class="carta-guia__marco" set:html={svgMarco(pagina.palo)} />
  <span class="carta-guia__indice" aria-hidden="true">
    {n}
    <svg viewBox="0 0 40 40"><use href={`#p-${pagina.palo}`} width="40" height="40"></use></svg>
  </span>
  <svg class="carta-guia__pip" viewBox="0 0 40 40" aria-hidden="true"><use href={`#p-${pagina.palo}`} width="40" height="40"></use></svg>
  <span class="carta-guia__titulo">{pagina.titulo}</span>
  <span class="carta-guia__resumen">{pagina.resumen}</span>
  <span class="carta-guia__indice carta-guia__indice--abajo" aria-hidden="true">
    {n}
    <svg viewBox="0 0 40 40"><use href={`#p-${pagina.palo}`} width="40" height="40"></use></svg>
  </span>
</a>

<style>
  .carta-guia {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    min-height: 290px;
    padding: 44px 24px 46px;
    background:
      radial-gradient(ellipse at 50% 40%, #fffef9, transparent 70%),
      var(--naipe);
    border-radius: 12px;
    border: 1px solid rgb(31 26 20 / 0.18);
    color: var(--tinta);
    text-decoration: none;
    box-shadow: var(--sombra-objeto);
    transition:
      transform 0.25s cubic-bezier(0.3, 1.4, 0.5, 1),
      box-shadow 0.25s ease;
  }
  .carta-guia:hover,
  .carta-guia:focus-visible {
    transform: translateY(-10px) rotate(0deg) !important;
    box-shadow:
      0 2px 2px rgb(30 20 10 / 0.12),
      0 26px 40px -14px rgb(30 20 10 / 0.5);
    z-index: 2;
  }
  .carta-guia__marco {
    position: absolute;
    inset: 8px;
    pointer-events: none;
  }
  .carta-guia__marco :global(svg) {
    width: 100%;
    height: 100%;
  }
  .carta-guia__indice {
    position: absolute;
    top: 14px;
    left: 16px;
    display: grid;
    justify-items: center;
    font-family: var(--f-titulo);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--c);
  }
  .carta-guia__indice svg {
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }
  .carta-guia__indice--abajo {
    top: auto;
    left: auto;
    bottom: 14px;
    right: 16px;
    transform: rotate(180deg);
  }
  .carta-guia__pip {
    width: 54px;
    height: 54px;
    margin-bottom: 4px;
  }
  .carta-guia__titulo {
    font-family: var(--f-titulo);
    font-weight: 750;
    font-size: 1.32rem;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .carta-guia__resumen {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--tinta-suave);
    text-wrap: pretty;
  }
  @media (max-width: 520px) {
    .carta-guia {
      min-height: 0;
      padding: 40px 18px 42px;
    }
  }
</style>
