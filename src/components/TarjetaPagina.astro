---
// Una sección de la guía dibujada como naipe español: índice en las esquinas,
// pinta en el marco y el título donde iría la figura.
import type { Pagina } from '../lib/paginas';
import { svgMarco, COLOR_PALO, NUMEROS } from '../lib/naipe';

interface Props {
  pagina: Pagina;
  /** Posición en la mano (define el número de la carta). */
  i?: number;
}
const { pagina, i = 0 } = Astro.props;
const n = NUMEROS[i % NUMEROS.length];
const color = COLOR_PALO[pagina.palo];
---
<a href={pagina.href} class="carta-guia" style={`--c:${color}`}>
  <span class="carta-guia__marco" set:html={svgMarco(pagina.palo)} />
  <span class="carta-guia__indice" aria-hidden="true">
    {n}
    <svg viewBox="0 0 40 40"><use href={`#p-${pagina.palo}`} width="40" height="40"></use></svg>
  </span>
  <svg class="carta-guia__pip" viewBox="0 0 40 40" aria-hidden="true"><use href={`#p-${pagina.palo}`} width="40" height="40"></use></svg>
  <span class="carta-guia__titulo">{pagina.titulo}</span>
  <span class="carta-guia__resumen">{pagina.resumen}</span>
  <span class="carta-guia__indice carta-guia__indice--abajo" aria-hidden="true">
    {n}
    <svg viewBox="0 0 40 40"><use href={`#p-${pagina.palo}`} width="40" height="40"></use></svg>
  </span>
</a>

<style>
  .carta-guia {
    --gx: 50%;
    --gy: 0%;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    min-height: 300px;
    padding: 44px 24px 46px;
    background: linear-gradient(160deg, #fffefa, #f4ecdc);
    border-radius: 16px;
    color: var(--tinta) !important;
    text-decoration: none;
    rotate: var(--giro, 0deg);
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.12),
      0 24px 40px -18px rgb(0 0 0 / 0.6);
    transition:
      rotate 0.5s var(--ease),
      translate 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
    transform-style: preserve-3d;
  }
  /* Brillo que sigue al puntero */
  .carta-guia::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at var(--gx) var(--gy), rgb(255 255 255 / 0.65), transparent 45%);
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .carta-guia:hover::after {
    opacity: 1;
  }
  .carta-guia:hover,
  .carta-guia:focus-visible {
    rotate: 0deg;
    translate: 0 -10px;
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.12),
      0 40px 60px -22px rgb(0 0 0 / 0.75),
      0 0 0 2px rgb(242 193 78 / 0.6);
    z-index: 2;
  }
  .carta-guia__marco {
    position: absolute;
    inset: 8px;
    pointer-events: none;
  }
  .carta-guia__marco :global(svg) {
    width: 100%;
    height: 100%;
  }
  .carta-guia__indice {
    position: absolute;
    top: 14px;
    left: 16px;
    display: grid;
    justify-items: center;
    font-family: var(--f-titulo);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--c);
  }
  .carta-guia__indice svg {
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }
  .carta-guia__indice--abajo {
    top: auto;
    left: auto;
    bottom: 14px;
    right: 16px;
    transform: rotate(180deg);
  }
  .carta-guia__pip {
    width: 54px;
    height: 54px;
    margin-bottom: 4px;
  }
  .carta-guia__titulo {
    font-family: var(--f-titulo);
    font-weight: 650;
    font-size: 1.32rem;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .carta-guia__resumen {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--tinta-suave);
    text-wrap: pretty;
  }
  @media (max-width: 520px) {
    .carta-guia {
      min-height: 0;
      padding: 40px 18px 42px;
    }
  }
</style>
