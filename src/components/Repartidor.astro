---
// Mesa de la portada: reparte cinco cartas con animación y cuenta los puntos.
import { svgDorso } from '../lib/naipe';
---
<div class="repartidor" data-repartidor>
  <div class="repartidor__mesa">
    <div class="repartidor__cartas" data-cartas>
      {[0, 1, 2, 3, 4].map((i) => (
        <div class="repartidor__carta" style={`--i:${i}`}>
          <div class="repartidor__giro">
            <div class="repartidor__cara repartidor__cara--dorso" set:html={svgDorso()} />
            <div class="repartidor__cara repartidor__cara--frente" />
          </div>
        </div>
      ))}
    </div>
    <div class="repartidor__marcador" aria-live="polite">
      <span class="repartidor__puntos" data-puntos>¿?</span>
      <span class="repartidor__texto" data-texto>Toca «Repartir» y mira qué te toca</span>
    </div>
  </div>
  <div class="repartidor__botones">
    <button type="button" class="boton" data-repartir>Repartir una mano</button>
    <a href="/valor-de-las-cartas/" class="repartidor__enlace">¿Cómo se cuenta?</a>
  </div>
  <p class="repartidor__racha" data-racha hidden></p>
</div>

<script>
  import { baraja, barajar, puntuar, type Carta } from '../lib/ajiley';
  import { svgNaipe } from '../lib/naipe';
  import probs from '../data/probabilidades.json';

  // Porcentaje de manos posibles que quedan por debajo de una puntuación.
  const peorQue = (p: number) => {
    const fila = probs.distribucion.find((d) => d.puntos === p);
    return fila ? Math.round((1 - fila.alMenos) * 100) : 0;
  };

  const raiz = document.querySelector<HTMLElement>('[data-repartidor]');
  if (raiz) {
    const cartasEl = [...raiz.querySelectorAll<HTMLElement>('.repartidor__carta')];
    const puntosEl = raiz.querySelector<HTMLElement>('[data-puntos]')!;
    const textoEl = raiz.querySelector<HTMLElement>('[data-texto]')!;
    const rachaEl = raiz.querySelector<HTMLElement>('[data-racha]')!;
    const boton = raiz.querySelector<HTMLButtonElement>('[data-repartir]')!;
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let manos = 0;
    let mejor = 0;

    const comentario = (p: number, ajiley: boolean) => {
      if (ajiley) return '¡AJILEY! La jugada máxima: sale una vez cada 4.700 manos.';
      const pct = peorQue(p);
      if (p >= 41) return `¡Manón! Mejor que el ${pct} % de las manos. Aquí se sube.`;
      if (p >= 36) return `Muy buena: mejor que el ${pct} % de las manos.`;
      if (p >= 30) return `Buena mano, hay con qué ir: mejor que el ${pct} % de las manos.`;
      if (p >= 21) return `Normalita (mejor que el ${pct} %). Todo depende de lo que botes.`;
      return `Flojita: solo supera al ${pct} % de las manos. Hay manos que es mejor dejar pasar.`;
    };

    boton.addEventListener('click', () => {
      boton.disabled = true;
      const mano: Carta[] = barajar(baraja()).slice(0, 5);
      const r = puntuar(mano);
      raiz.classList.remove('es-ajiley');
      cartasEl.forEach((c) => c.classList.remove('esta-volteada', 'cuenta'));
      puntosEl.textContent = '…';
      textoEl.textContent = 'Repartiendo…';

      setTimeout(
        () => {
          cartasEl.forEach((el, i) => {
            const c = mano[i];
            el.querySelector<HTMLElement>('.repartidor__cara--frente')!.innerHTML = svgNaipe(c.n, c.palo);
            el.classList.toggle('cuenta', r.cuentan.includes(c));
            setTimeout(() => el.classList.add('esta-volteada'), reducido ? 0 : i * 140);
          });
          setTimeout(
            () => {
              manos++;
              mejor = Math.max(mejor, r.puntos);
              puntosEl.textContent = String(r.puntos);
              textoEl.textContent = `${r.ajiley ? '' : `puntos en ${r.palo}. `}${comentario(r.puntos, r.ajiley)}`;
              raiz.classList.toggle('es-ajiley', r.ajiley);
              rachaEl.hidden = manos < 2;
              rachaEl.textContent = `Llevas ${manos} manos repartidas · tu mejor mano: ${mejor} puntos`;
              boton.textContent = 'Repartir otra';
              boton.disabled = false;
            },
            reducido ? 0 : 5 * 140 + 350,
          );
        },
        reducido ? 0 : 250,
      );
    });
  }
</script>

<style>
  .repartidor {
    text-align: center;
  }
  .repartidor__mesa {
    position: relative;
    padding: clamp(22px, 4vw, 34px) 14px 22px;
    border-radius: 28px;
    border: var(--borde-sticker);
    box-shadow:
      0 8px 0 var(--noche),
      inset 0 0 0 8px rgb(122 74 30 / 0.95),
      inset 0 0 0 10px rgb(0 0 0 / 0.25);
    background:
      radial-gradient(ellipse at 50% 35%, rgb(255 255 255 / 0.12), transparent 60%),
      repeating-radial-gradient(circle at 20% 30%, rgb(0 0 0 / 0.025) 0 2px, transparent 2px 4px), var(--tapete);
    overflow: hidden;
  }
  .repartidor__cartas {
    display: flex;
    justify-content: center;
    gap: clamp(4px, 1.4vw, 10px);
    perspective: 900px;
  }
  .repartidor__carta {
    width: clamp(54px, 13vw, 96px);
    aspect-ratio: 2 / 3;
  }
  .repartidor__carta:nth-child(1) {
    transform: rotate(-6deg) translateY(10px);
  }
  .repartidor__carta:nth-child(2) {
    transform: rotate(-3deg) translateY(4px);
  }
  .repartidor__carta:nth-child(4) {
    transform: rotate(3deg) translateY(4px);
  }
  .repartidor__carta:nth-child(5) {
    transform: rotate(6deg) translateY(10px);
  }
  .repartidor__giro {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .esta-volteada .repartidor__giro {
    transform: rotateY(180deg);
  }
  .repartidor__cara {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }
  .repartidor__cara :global(svg) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 3px 0 rgb(0 0 0 / 0.25));
  }
  .repartidor__cara--frente {
    transform: rotateY(180deg);
  }
  .esta-volteada.cuenta {
    translate: 0 -10px;
    transition: translate 0.3s ease 0.6s;
  }
  .es-ajiley .esta-volteada .repartidor__cara--frente :global(svg) {
    filter: drop-shadow(0 0 10px rgb(255 194 14 / 0.9));
  }
  .repartidor__marcador {
    display: grid;
    gap: 2px;
    margin-top: 18px;
    color: #fff;
  }
  .repartidor__puntos {
    font-family: var(--f-titulo);
    font-weight: 800;
    font-size: clamp(2.4rem, 7vw, 3.4rem);
    line-height: 1;
    color: var(--oro);
  }
  .es-ajiley .repartidor__puntos {
    animation: latido 0.9s ease-in-out 3;
  }
  @keyframes latido {
    50% {
      transform: scale(1.15);
    }
  }
  .repartidor__texto {
    font-weight: 700;
    min-height: 1.6em;
    padding-inline: 8px;
  }
  .repartidor__botones {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 22px;
  }
  .repartidor__enlace {
    font-weight: 800;
  }
  .repartidor__racha {
    margin: 12px 0 0;
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }
</style>
