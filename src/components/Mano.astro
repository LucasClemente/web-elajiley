---
import Naipe from './Naipe.astro';
import type { Numero, Palo } from '../lib/naipe';

interface Props {
  /** Cartas en notación corta: "1o 12o 7c" (número + inicial del palo: o, c, e, b). */
  cartas: string;
  /** Índices (desde 0) de las cartas que no cuentan para la mano. */
  apagar?: number[];
  titulo?: string;
  /** Texto del resultado, p. ej. "38 puntos en oros". */
  resultado?: string;
  tam?: 's' | 'm' | 'l';
}
const { cartas, apagar = [], titulo, resultado, tam = 'm' } = Astro.props;

const PALO: Record<string, Palo> = { o: 'oros', c: 'copas', e: 'espadas', b: 'bastos' };
const lista = cartas
  .trim()
  .split(/\s+/)
  .map((c) => ({ n: Number(c.slice(0, -1)) as Numero, palo: PALO[c.slice(-1)] }));
---
<figure class="mano">
  {titulo && <figcaption class="mano__titulo">{titulo}</figcaption>}
  <div class="mano__cartas">
    {lista.map((c, i) => <Naipe n={c.n} palo={c.palo} apagada={apagar.includes(i)} tam={tam} />)}
  </div>
  {resultado && <p class="mano__resultado">{resultado}</p>}
</figure>

<style>
  .mano {
    margin: 1.8em 0 2em;
    padding: 20px 16px 18px;
    background:
      var(--fieltro),
      radial-gradient(ellipse at 50% 30%, rgb(255 255 255 / 0.1), transparent 65%),
      var(--tapete);
    border: 10px solid var(--madera);
    border-image: linear-gradient(135deg, #8c5a2f, #5a3216 40%, #7a4a22 60%, #4e2a12) 10;
    box-shadow: var(--sombra-objeto);
    text-align: center;
  }
  .mano__titulo {
    font-family: var(--f-mano);
    font-weight: 700;
    color: var(--oro);
    font-size: 1.45rem;
    line-height: 1.1;
    margin-bottom: 12px;
  }
  .mano__cartas {
    display: flex;
    justify-content: center;
    gap: clamp(4px, 1.5vw, 10px);
    flex-wrap: wrap;
  }
  .mano__cartas > :global(.naipe:nth-child(odd)) {
    rotate: -2deg;
  }
  .mano__cartas > :global(.naipe:nth-child(even)) {
    rotate: 1.5deg;
  }
  .mano__resultado {
    display: inline-block;
    margin: 16px 0 0;
    padding: 0.15em 0.9em 0.2em;
    background: var(--naipe);
    color: var(--tinta);
    font-family: var(--f-mano);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.2;
    transform: rotate(-1.5deg);
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.3);
  }
</style>
