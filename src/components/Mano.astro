---
import Naipe from './Naipe.astro';
import type { Numero, Palo } from '../lib/naipe';

interface Props {
  /** Cartas en notación corta: "1o 12o 7c" (número + inicial del palo: o, c, e, b). */
  cartas: string;
  /** Índices (desde 0) de las cartas que no cuentan para la mano. */
  apagar?: number[];
  titulo?: string;
  /** Texto del resultado, p. ej. "38 puntos en oros". */
  resultado?: string;
  tam?: 's' | 'm' | 'l';
}
const { cartas, apagar = [], titulo, resultado, tam = 'm' } = Astro.props;

const PALO: Record<string, Palo> = { o: 'oros', c: 'copas', e: 'espadas', b: 'bastos' };
const lista = cartas
  .trim()
  .split(/\s+/)
  .map((c) => ({ n: Number(c.slice(0, -1)) as Numero, palo: PALO[c.slice(-1)] }));
---
<figure class="mano">
  {titulo && <figcaption class="mano__titulo">{titulo}</figcaption>}
  <div class="mano__cartas">
    {lista.map((c, i) => <Naipe n={c.n} palo={c.palo} apagada={apagar.includes(i)} tam={tam} />)}
  </div>
  {resultado && <p class="mano__resultado">{resultado}</p>}
</figure>

<style>
  .mano {
    margin: 2em 0 2.2em;
    padding: 24px 18px 22px;
    border-radius: 24px;
    background:
      var(--fieltro),
      radial-gradient(ellipse at 50% 20%, rgb(64 200 135 / 0.28), transparent 65%), var(--tapete-900);
    box-shadow:
      inset 0 0 0 1px rgb(242 193 78 / 0.2),
      0 30px 50px -28px rgb(0 0 0 / 0.7);
    text-align: center;
    perspective: 900px;
  }
  .mano__titulo {
    font-family: var(--f-titulo);
    font-weight: 600;
    color: #fff8ea;
    font-size: 1.15rem;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .mano__cartas {
    display: flex;
    justify-content: center;
    gap: clamp(4px, 1.5vw, 10px);
    flex-wrap: wrap;
  }
  .mano__cartas > :global(.naipe:nth-child(odd)) {
    rotate: -2deg;
  }
  .mano__cartas > :global(.naipe:nth-child(even)) {
    rotate: 1.5deg;
  }
  .mano__resultado {
    display: inline-block;
    margin: 20px 0 0;
    padding: 0.45em 1.2em;
    border-radius: 999px;
    background: var(--lamina);
    color: var(--tinta-oscura);
    font-weight: 900;
    line-height: 1.2;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.5), 0 10px 20px -10px rgb(0 0 0 / 0.6);
  }
</style>
