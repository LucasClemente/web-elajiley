---
// Tabla visual del valor de las cartas, generada desde VALOR (lib/ajiley).
import Naipe from './Naipe.astro';
import { VALOR } from '../lib/ajiley';
import { NUMEROS, NOMBRE_NUMERO, type Palo } from '../lib/naipe';

interface Props {
  palo?: Palo;
}
const { palo = 'copas' } = Astro.props;
---
<div class="valores">
  {NUMEROS.map((n) => (
    <div class:list={['valores__item', { 'valores__item--diez': VALOR[n] === 10, 'valores__item--as': n === 1 }]}>
      <Naipe n={n} palo={palo} tam="s" />
      <span class="valores__nombre">{NOMBRE_NUMERO[n]}</span>
      <span class="valores__puntos">{VALOR[n]}</span>
    </div>
  ))}
</div>

<style>
  .valores {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 8px;
    margin: 1.6em 0 2em;
    padding: 16px 12px 12px;
    background: var(--naipe);
    box-shadow: var(--sombra-objeto);
    border-top: 3px double var(--tinta);
    border-bottom: 3px double var(--tinta);
  }
  .valores__item {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
  }
  .valores__item :global(.naipe) {
    --ancho-naipe: 100%;
    max-width: 64px;
  }
  .valores__nombre {
    font-size: 0.78rem;
    color: var(--tinta-suave);
    font-weight: 700;
  }
  .valores__puntos {
    font-family: var(--f-mano);
    font-weight: 700;
    font-size: 1.9rem;
    line-height: 1;
    color: var(--tinta-suave);
  }
  .valores__item--diez .valores__puntos {
    color: var(--tapete);
  }
  .valores__item--as .valores__puntos {
    color: var(--rojo);
    position: relative;
  }
  /* Círculo a mano alrededor del 11 */
  .valores__item--as .valores__puntos::after {
    content: '';
    position: absolute;
    inset: -6px -9px -4px;
    border: 2px solid var(--rojo);
    border-radius: 50% 45% 55% 48%;
    transform: rotate(-8deg);
  }
  @media (max-width: 720px) {
    .valores {
      grid-template-columns: repeat(5, 1fr);
      row-gap: 14px;
    }
  }
</style>
