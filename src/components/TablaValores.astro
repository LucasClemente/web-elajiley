---
// Tabla visual del valor de las cartas, generada desde VALOR (lib/ajiley).
import Naipe from './Naipe.astro';
import { VALOR } from '../lib/ajiley';
import { NUMEROS, NOMBRE_NUMERO, type Palo } from '../lib/naipe';

interface Props {
  palo?: Palo;
}
const { palo = 'copas' } = Astro.props;
---
<div class="valores">
  {NUMEROS.map((n) => (
    <div class:list={['valores__item', { 'valores__item--diez': VALOR[n] === 10, 'valores__item--as': n === 1 }]}>
      <Naipe n={n} palo={palo} tam="s" />
      <span class="valores__nombre">{NOMBRE_NUMERO[n]}</span>
      <span class="valores__puntos">{VALOR[n]}</span>
    </div>
  ))}
</div>

<style>
  .valores {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 8px;
    margin: 1.4em 0 1.8em;
    padding: 14px 10px;
    background: #fff;
    border: 2px solid var(--linea);
    border-radius: var(--radio);
  }
  .valores__item {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
  }
  .valores__item :global(.naipe) {
    --ancho-naipe: 100%;
    max-width: 64px;
  }
  .valores__nombre {
    font-size: 0.78rem;
    color: var(--tinta-suave);
    font-weight: 700;
  }
  .valores__puntos {
    font-family: var(--f-titulo);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1;
    min-width: 2em;
    padding: 0.2em 0.35em 0.1em;
    border-radius: 8px;
    background: var(--arena);
    color: var(--noche);
  }
  .valores__item--diez .valores__puntos {
    background: var(--tapete-100);
    color: var(--tapete-700);
  }
  .valores__item--as .valores__puntos {
    background: var(--oro);
    color: var(--noche-900);
  }
  @media (max-width: 720px) {
    .valores {
      grid-template-columns: repeat(5, 1fr);
      row-gap: 14px;
    }
  }
</style>
