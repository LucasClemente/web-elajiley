---
// "Guaca dice": la guacamaya de Betzue da consejos en un bocadillo de cómic.
import { Image } from 'astro:assets';
import guaca from '../assets/marca/guaca.png';

interface Props {
  titulo?: string;
}
const { titulo = 'Guaca dice:' } = Astro.props;
---
<aside class="consejo">
  <Image src={guaca} alt="" width={110} height={110} densities={[1, 2]} class="consejo__guaca" loading="lazy" />
  <div class="consejo__bocadillo">
    <strong class="consejo__titulo">{titulo}</strong>
    <slot />
  </div>
</aside>

<style>
  .consejo {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 18px;
    align-items: end;
    margin: 2em 0;
  }
  .consejo__guaca {
    width: 96px;
    height: 96px;
    object-fit: contain;
    filter: drop-shadow(0 6px 6px rgb(30 20 10 / 0.25));
  }
  .consejo__bocadillo {
    position: relative;
    padding: 18px 22px 16px;
    background: #fff;
    border-radius: 22px 22px 22px 6px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 18px 36px -18px rgb(20 14 6 / 0.35);
  }
  .consejo__bocadillo::before {
    content: '';
    position: absolute;
    left: -10px;
    bottom: 10px;
    width: 18px;
    height: 18px;
    background: #fff;
    clip-path: polygon(100% 0, 0 100%, 100% 100%);
  }
  .consejo__titulo {
    display: block;
    font-weight: 900;
    color: var(--rojo);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.4em;
  }
  .consejo__bocadillo :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 480px) {
    .consejo {
      grid-template-columns: 64px 1fr;
      gap: 12px;
    }
    .consejo__guaca {
      width: 64px;
      height: 64px;
    }
  }
</style>
