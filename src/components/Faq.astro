---
// Bloque de preguntas frecuentes para páginas .astro (los MDX lo traen en la plantilla).
interface Props {
  preguntas: { q: string; a: string }[];
  titulo?: string;
  id?: string;
}
const { preguntas, titulo = 'Preguntas frecuentes', id = 'preguntas' } = Astro.props;
---
<section class="faq" aria-labelledby={id}>
  <h2 id={id}>{titulo}</h2>
  {preguntas.map((f) => (
    <details class="faq__item">
      <summary>{f.q}</summary>
      <p set:html={f.a} />
    </details>
  ))}
</section>

<style>
  .faq__item {
    background: var(--superficie);
    border: 1px solid var(--superficie-borde);
    border-radius: 14px;
    margin-bottom: 10px;
    padding: 0 1.1em;
    border-left: 4px solid var(--rojo);
  }
  .faq__item summary {
    cursor: pointer;
    padding: 0.95em 0;
    font-family: var(--f-titulo);
    font-weight: 650;
    font-size: 1.12rem;
    color: var(--tinta);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    font-size: 1.5rem;
    line-height: 1;
    color: var(--rojo);
    transition: transform 0.2s ease;
  }
  .faq__item[open] summary::after {
    transform: rotate(45deg);
  }
  .faq__item p {
    margin: 0 0 1em;
  }
</style>
