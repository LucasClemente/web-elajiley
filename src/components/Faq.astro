---
// Bloque de preguntas frecuentes para páginas .astro (los MDX lo traen en la plantilla).
// El JSON-LD FAQPage lo añade la página con faqSchema().
interface Props {
  preguntas: { q: string; a: string }[];
  titulo?: string;
  id?: string;
}
const { preguntas, titulo = 'Preguntas frecuentes', id = 'preguntas' } = Astro.props;
---
<section class="faq" aria-labelledby={id}>
  <h2 id={id}>{titulo}</h2>
  {preguntas.map((f) => (
    <details class="faq__item">
      <summary>{f.q}</summary>
      <p set:html={f.a} />
    </details>
  ))}
</section>

<style>
  .faq__item {
    background: #fff;
    border: 2px solid var(--linea);
    border-radius: var(--radio-s);
    margin-bottom: 10px;
    padding: 0 1.1em;
  }
  .faq__item summary {
    cursor: pointer;
    padding: 0.9em 0;
    font-weight: 800;
    color: var(--noche);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    font-family: var(--f-titulo);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--tapete);
  }
  .faq__item[open] summary::after {
    content: '–';
  }
  .faq__item p {
    margin: 0 0 1em;
  }
</style>
