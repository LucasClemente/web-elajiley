---
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo-cabecera.png';
import { NAV, BETZUE } from '../config';

const actual = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
---
<header class="cabecera" data-cabecera>
  <div class="contenedor cabecera__fila">
    <a href="/" class="cabecera__logo" aria-label="El Ajiley, ir al inicio">
      <Image src={logo} alt="El Ajiley" width={164} densities={[1, 2]} loading="eager" />
    </a>

    <nav id="menu-principal" class="cabecera__nav" aria-label="Principal">
      <ul>
        {NAV.filter((l) => l.href !== '/jugar-online/').map((l) => (
          <li>
            <a href={l.href} aria-current={activo(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
        <li class="cabecera__solo-movil"><a href="/practicar/">Practicar gratis</a></li>
        <li class="cabecera__solo-movil"><a href="/jugar-online/">Jugar online</a></li>
      </ul>
    </nav>

    <div class="cabecera__acciones">
      <a href="/practicar/" class="cabecera__practicar">Practicar gratis</a>
      <a href={BETZUE.ajiley('cabecera')} class="boton boton--betzue boton--peque cabecera__betzue">
        Jugar en <b>Betzue</b>
      </a>
      <button class="cabecera__menu" type="button" aria-expanded="false" aria-controls="menu-principal" data-boton-menu>
        <span class="sr-only">Abrir menú</span>
        <span class="cabecera__hamburguesa" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<script>
  const cab = document.querySelector<HTMLElement>('[data-cabecera]');
  const boton = document.querySelector<HTMLButtonElement>('[data-boton-menu]');
  boton?.addEventListener('click', () => {
    const abierto = cab?.toggleAttribute('data-abierto') ?? false;
    boton.setAttribute('aria-expanded', String(abierto));
  });
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(4 22 15 / 0.82);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid rgb(242 193 78 / 0.18);
    transition: background 0.4s var(--ease);
  }
  .cabecera.es-compacta {
    background: rgb(4 22 15 / 0.94);
  }
  .cabecera__fila {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 74px;
    transition: min-height 0.4s var(--ease);
  }
  .cabecera.es-compacta .cabecera__fila {
    min-height: 60px;
  }
  .cabecera__logo {
    flex: none;
  }
  .cabecera__logo img {
    width: 156px;
    height: auto;
    transition: width 0.4s var(--ease);
  }
  .cabecera.es-compacta .cabecera__logo img {
    width: 132px;
  }
  .cabecera__nav {
    flex: 1;
  }
  .cabecera__nav ul {
    display: flex;
    justify-content: center;
    gap: 2px 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cabecera__nav a {
    position: relative;
    display: block;
    padding: 0.5em 0.7em;
    color: #e8efe9;
    font-weight: 800;
    font-size: 0.93rem;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 999px;
    transition: color 0.25s ease, background 0.25s ease;
  }
  .cabecera__nav a:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.07);
  }
  .cabecera__nav a[aria-current='page'] {
    color: var(--oro);
  }
  .cabecera__nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.15em;
    width: 5px;
    height: 5px;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--oro);
  }
  .cabecera__solo-movil {
    display: none;
  }
  .cabecera__acciones {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: none;
  }
  .cabecera__practicar {
    color: #e8efe9;
    font-weight: 800;
    font-size: 0.93rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .cabecera__practicar:hover {
    color: var(--oro);
  }
  .cabecera__betzue b {
    color: var(--oro);
    font-weight: 900;
  }
  .cabecera__menu {
    display: none;
    background: none;
    border: 0;
    width: 44px;
    height: 44px;
    place-items: center;
    cursor: pointer;
  }
  .cabecera__hamburguesa {
    display: grid;
    gap: 5px;
  }
  .cabecera__hamburguesa i {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: #fff;
    transition: transform 0.35s var(--ease), opacity 0.2s ease;
  }
  .cabecera[data-abierto] .cabecera__hamburguesa i:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .cabecera[data-abierto] .cabecera__hamburguesa i:nth-child(2) {
    opacity: 0;
  }
  .cabecera[data-abierto] .cabecera__hamburguesa i:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1120px) {
    .cabecera__practicar {
      display: none;
    }
  }
  @media (max-width: 980px) {
    .cabecera__fila {
      justify-content: space-between;
    }
    .cabecera__menu {
      display: grid;
    }
    .cabecera__nav {
      position: absolute;
      inset: 100% 0 auto;
      height: calc(100svh - 100%);
      padding: 18px var(--gutter) 30px;
      background:
        var(--fieltro),
        radial-gradient(ellipse at 50% 0%, rgb(46 160 105 / 0.3), transparent 60%), #04160f;
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      transition:
        clip-path 0.55s var(--ease),
        visibility 0s linear 0.55s;
    }
    .cabecera[data-abierto] .cabecera__nav {
      clip-path: inset(0 0 0 0);
      visibility: visible;
      transition: clip-path 0.55s var(--ease);
    }
    .cabecera__nav ul {
      flex-direction: column;
      gap: 0;
    }
    .cabecera__nav a {
      font-family: var(--f-titulo);
      font-size: 1.9rem;
      font-weight: 600;
      padding: 0.35em 0;
      border-radius: 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }
    .cabecera__nav a[aria-current='page']::after {
      display: none;
    }
    .cabecera__solo-movil {
      display: list-item;
    }
  }
  @media (max-width: 440px) {
    .cabecera__logo img,
    .cabecera.es-compacta .cabecera__logo img {
      width: 122px;
    }
    .cabecera__betzue {
      font-size: 0.72rem;
      padding-inline: 0.9em;
    }
    .cabecera__acciones {
      gap: 4px;
    }
  }
</style>
