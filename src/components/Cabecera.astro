---
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo-cabecera.png';
import { NAV, BETZUE } from '../config';

const actual = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
---
<div class="palos-franja" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
<header class="cabecera" data-cabecera>
  <div class="contenedor cabecera__fila">
    <a href="/" class="cabecera__logo" aria-label="El Ajiley, ir al inicio">
      <Image src={logo} alt="El Ajiley" width={164} densities={[1, 2]} loading="eager" />
    </a>

    <nav id="menu-principal" class="cabecera__nav" aria-label="Principal">
      <ul>
        {NAV.filter((l) => l.href !== '/jugar-online/').map((l) => (
          <li>
            <a href={l.href} aria-current={activo(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
        <li class="cabecera__solo-movil"><a href="/practicar/">Practicar gratis</a></li>
        <li class="cabecera__solo-movil"><a href="/jugar-online/">Jugar online</a></li>
      </ul>
    </nav>

    <div class="cabecera__acciones">
      <a href="/practicar/" class="cabecera__practicar">Practicar gratis</a>
      <a href={BETZUE.ajiley('cabecera')} class="boton boton--betzue boton--peque cabecera__betzue">
        Jugar en <b>Betzue</b>
      </a>
      <button class="cabecera__menu" type="button" aria-expanded="false" aria-controls="menu-principal" data-boton-menu>
        <span class="sr-only">Abrir menú</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 7h16M4 12h11M4 17h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const cab = document.querySelector<HTMLElement>('[data-cabecera]');
  const boton = document.querySelector<HTMLButtonElement>('[data-boton-menu]');
  boton?.addEventListener('click', () => {
    const abierto = cab?.toggleAttribute('data-abierto') ?? false;
    boton.setAttribute('aria-expanded', String(abierto));
  });
</script>

<style>
  /* Franja con los colores de los cuatro palos */
  .palos-franja {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 5px;
  }
  .palos-franja span:nth-child(1) {
    background: var(--oro);
  }
  .palos-franja span:nth-child(2) {
    background: var(--rojo);
  }
  .palos-franja span:nth-child(3) {
    background: var(--caribe);
  }
  .palos-franja span:nth-child(4) {
    background: var(--tapete-claro);
  }
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--grano), rgb(243 234 216 / 0.97);
    border-bottom: 3px double rgb(31 26 20 / 0.7);
  }
  .cabecera__fila {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 72px;
  }
  .cabecera__logo {
    flex: none;
  }
  .cabecera__logo img {
    width: 164px;
    height: auto;
  }
  .cabecera__nav {
    flex: 1;
  }
  .cabecera__nav ul {
    display: flex;
    justify-content: center;
    gap: 2px 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cabecera__nav a {
    position: relative;
    display: block;
    padding: 0.45em 0.55em;
    color: var(--tinta);
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .cabecera__nav a::after {
    content: '';
    position: absolute;
    left: 0.4em;
    right: 0.4em;
    bottom: 0.1em;
    height: 0.4em;
    background: var(--subrayado) no-repeat center / 100% 100%;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .cabecera__nav a:hover::after,
  .cabecera__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .cabecera__nav a[aria-current='page'] {
    color: var(--rojo);
  }
  .cabecera__solo-movil {
    display: none;
  }
  .cabecera__acciones {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
  }
  .cabecera__practicar {
    font-family: var(--f-mano);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--tapete);
    text-decoration: none;
    white-space: nowrap;
  }
  .cabecera__practicar:hover {
    text-decoration: underline;
  }
  .cabecera__betzue b {
    color: var(--oro);
    font-weight: 900;
  }
  .cabecera__menu {
    display: none;
    background: none;
    border: 0;
    color: var(--tinta);
    width: 44px;
    height: 44px;
    place-items: center;
    cursor: pointer;
  }

  @media (max-width: 1120px) {
    .cabecera__practicar {
      display: none;
    }
  }
  @media (max-width: 980px) {
    .cabecera__fila {
      justify-content: space-between;
    }
    .cabecera__menu {
      display: grid;
    }
    .cabecera__nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      padding: 10px var(--gutter) 22px;
      background: var(--grano), var(--papel);
      border-bottom: 3px double rgb(31 26 20 / 0.7);
      box-shadow: 0 18px 30px -18px rgb(30 20 10 / 0.4);
    }
    .cabecera[data-abierto] .cabecera__nav {
      display: block;
    }
    .cabecera__nav ul {
      flex-direction: column;
      gap: 0;
    }
    .cabecera__nav a {
      font-family: var(--f-titulo);
      font-size: 1.45rem;
      font-weight: 650;
      padding: 0.5em 0;
      border-bottom: 1px solid var(--linea);
    }
    .cabecera__nav a::after {
      display: none;
    }
    .cabecera__solo-movil {
      display: list-item;
    }
  }
  @media (max-width: 440px) {
    .cabecera__logo img {
      width: 128px;
    }
    .cabecera__betzue {
      font-size: 0.74rem;
      padding-inline: 0.8em;
    }
    .cabecera__acciones {
      gap: 6px;
    }
  }
</style>
