---
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo-cabecera.png';
import { NAV } from '../config';

const actual = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
---
<header class="cabecera" data-cabecera>
  <div class="contenedor cabecera__fila">
    <a href="/" class="cabecera__logo" aria-label="El Ajiley, ir al inicio">
      <Image src={logo} alt="El Ajiley" width={172} densities={[1, 2]} loading="eager" />
    </a>

    <button class="cabecera__menu" type="button" aria-expanded="false" aria-controls="menu-principal" data-boton-menu>
      <span class="sr-only">Abrir menú</span>
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" fill="none"></path></svg>
    </button>

    <nav id="menu-principal" class="cabecera__nav" aria-label="Principal">
      <ul>
        {NAV.map((l) => (
          <li>
            <a href={l.href} aria-current={activo(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <a href="/practicar/" class="boton boton--peque cabecera__cta">Practicar gratis</a>
    </nav>
  </div>
</header>

<script>
  const cab = document.querySelector<HTMLElement>('[data-cabecera]');
  const boton = document.querySelector<HTMLButtonElement>('[data-boton-menu]');
  boton?.addEventListener('click', () => {
    const abierto = cab?.toggleAttribute('data-abierto') ?? false;
    boton.setAttribute('aria-expanded', String(abierto));
  });
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 250 240 / 0.94);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 2px solid var(--linea);
  }
  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }
  .cabecera__logo {
    display: block;
    flex: none;
  }
  .cabecera__logo img {
    width: 172px;
    height: auto;
  }
  .cabecera__nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .cabecera__nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cabecera__nav ul a {
    display: block;
    padding: 0.4em 0.65em;
    border-radius: 999px;
    color: var(--noche);
    font-weight: 800;
    font-size: 0.97rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .cabecera__nav ul a:hover {
    background: var(--tapete-100);
  }
  .cabecera__nav ul a[aria-current='page'] {
    background: var(--noche);
    color: #fff;
  }
  .cabecera__menu {
    display: none;
    background: none;
    border: 2px solid var(--noche);
    border-radius: 12px;
    color: var(--noche);
    width: 46px;
    height: 46px;
    place-items: center;
    cursor: pointer;
  }

  @media (max-width: 1080px) {
    .cabecera__menu {
      display: grid;
    }
    .cabecera__nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 12px var(--gutter) 20px;
      background: var(--papel);
      border-bottom: 2px solid var(--linea);
      box-shadow: 0 18px 30px -18px rgb(10 47 110 / 0.35);
    }
    .cabecera[data-abierto] .cabecera__nav {
      display: flex;
    }
    .cabecera__nav ul {
      flex-direction: column;
    }
    .cabecera__nav ul a {
      padding: 0.7em 0.9em;
      font-size: 1.05rem;
      border-radius: 12px;
    }
  }
  @media (max-width: 400px) {
    .cabecera__logo img {
      width: 148px;
    }
  }
</style>
